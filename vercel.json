{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "impactlist.vercel.app" }],
      "destination": "https://impactlist.xyz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "impactlist.vercel.app" }],
      "destination": "https://impactlist.xyz/:path*",
      "permanent": true
    },
    {
      "source": "/categories",
      "destination": "/causes",
      "permanent": true
    },
    {
      "source": "/category/:categoryId",
      "destination": "/cause/:categoryId",
      "permanent": true
    }
  ],
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|favicon\\.svg|robots\\.txt|sitemap\\.xml|@vite/|@react-refresh|src/|node_modules/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "buildCommand": "npm run build"
}
